@using PharmacyManagement.Web.ViewModels.Medicines;
@using PharmacySystem.Core;
@model PaginatedList<PharmacyManagement.Web.ViewModels.Medicines.MedicineIndexViewModel>

@{
    ViewData["Title"] = "Medicines List";
}

<!-- CSS Style for Hover Animation & Theme Customization -->
<style>
    .medicine-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .medicine-card:hover {
        transform: translateY(-5px) scale(1.02);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.12) !important;
    }
    .hover-teal:hover {
        color: #0f766e !important;
    }
</style>

<div class="container-fluid pt-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-secondary d-flex align-items-center gap-2">
            <i class="bi bi-capsule text-teal" style="color: #0f766e;"></i> Medicines Catalog
        </h2>
        <a asp-controller="Medicine" asp-action="Create" class="btn btn-success px-4 fw-semibold d-inline-flex align-items-center gap-2" style="background-color: #0f766e; border-color: #0f766e;">
            <i class="bi bi-plus-circle-fill"></i> Add New Medicine
        </a>
    </div>

    <!-- Live Search Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-11">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               id="searchInput"
                               class="form-control border-start-0 ps-0"
                               placeholder="Type to filter medicines in current page..."
                               autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-1 text-end">
                    <button type="button" id="clearSearchBtn" class="btn btn-outline-secondary w-100 d-inline-flex align-items-center justify-content-center" title="Clear Search">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Cards Grid Container -->
    <div class="row g-3" id="medicinesGrid">
        @if (Model != null && Model.Any())
        {
            @foreach (var medicine in Model)
            {
                <div class="col-12 col-md-6 col-lg-4 col-xl-3 medicine-card-item">
                    <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden medicine-card">

                        <!-- Header: Category & Stock Badges -->
                        <div class="card-header bg-light border-0 d-flex justify-content-between align-items-center pt-3 px-3">
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border fw-normal px-2 py-1">
                                <i class="bi bi-tags me-1"></i>@medicine.CategoryName
                            </span>
                            @if (medicine.IsOutOfStock)
                            {
                                <span class="badge bg-danger rounded-pill px-2 py-1">
                                    <i class="bi bi-x-circle-fill me-1"></i> Out of Stock
                                </span>
                            }
                            else if (medicine.IsLowStock)
                            {
                                <span class="badge bg-warning text-dark rounded-pill px-2 py-1">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Low Stock
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success rounded-pill px-2 py-1">
                                    <i class="bi bi-check-circle-fill me-1"></i> In Stock
                                </span>
                            }
                        </div>

                        <!-- Card Body: Large Name & Info -->
                        <div class="card-body px-3 py-3">
                            <h4 class="fw-bold mb-2 medicine-name">
                                <a asp-action="Details" asp-route-id="@medicine.Id" class="text-decoration-none text-dark hover-teal">
                                    <i class="bi bi-capsule-pill me-1" style="color: #0f766e;"></i> @medicine.Name
                                </a>
                            </h4>

                            <div class="d-flex justify-content-between align-items-center my-3 bg-light p-2 rounded-2">
                                <div>
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">Price</small>
                                    <span class="fs-5 fw-bold text-success">$@medicine.SellingPrice</span>
                                </div>
                                <div class="text-end">
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">Quantity</small>
                                    <span class="fs-6 fw-bold text-dark">@medicine.StockQuantity units</span>
                                </div>
                            </div>

                            <div class="pt-1">
                                <small class="text-muted d-block" style="font-size: 0.8rem;">
                                    <i class="bi bi-calendar-event me-1"></i> Expiry: 
                                    <span class="fw-semibold text-secondary">
                                        @(medicine.ExpiryDate.HasValue ? medicine.ExpiryDate.Value.ToString("yyyy-MM-dd") : "No Date")
                                    </span>
                                </small>
                            </div>
                        </div>

                        <!-- Card Footer: 3 Action Buttons -->
                        <div class="card-footer bg-white border-0 d-flex gap-2 p-3 pt-0">
                            <a asp-action="Details" asp-route-id="@medicine.Id" class="btn btn-sm btn-outline-secondary w-33 d-inline-flex align-items-center justify-content-center" title="Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@medicine.Id" class="btn btn-sm btn-outline-warning w-33 d-inline-flex align-items-center justify-content-center" title="Edit">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@medicine.Id" class="btn btn-sm btn-outline-danger w-33 d-inline-flex align-items-center justify-content-center" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }

            <!-- No Search Results Dynamic Card -->
            <div class="col-12" id="noResultsCard" style="display: none;">
                <div class="card border-0 shadow-sm rounded-3 text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    <h5>No medicines found matching your search.</h5>
                </div>
            </div>
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-3 text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    <h5>No medicines available.</h5>
                </div>
            </div>
        }
    </div>

    <!-- Pagination Controls -->
    @if (Model != null && Model.TotalPages > 1)
    {
        <div class="d-flex flex-column align-items-center justify-content-center gap-2 mt-4 pb-3" id="paginationContainer">
            <nav>
                <ul class="pagination pagination-sm mb-0 gap-1">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a asp-action="Index"
                           asp-route-pageNumber="@(Model.PageIndex - 1)"
                           class="page-link rounded-2 text-secondary border-0 bg-light px-3 py-2">
                            <i class="bi bi-chevron-left me-1"></i> Previous
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a asp-action="Index"
                               asp-route-pageNumber="@i"
                               class="page-link rounded-2 border-0 px-3 py-2 fw-semibold @(i == Model.PageIndex ? "text-white" : "text-dark bg-light")"
                               style="@(i == Model.PageIndex ? "background-color: #0f766e;" : "")">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a asp-action="Index"
                           asp-route-pageNumber="@(Model.PageIndex + 1)"
                           class="page-link rounded-2 text-secondary border-0 bg-light px-3 py-2">
                            Next <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    </li>
                </ul>
            </nav>

            <div>
                <span class="text-muted small fw-semibold">
                    Page <strong class="text-dark">@Model.PageIndex</strong> of <strong class="text-dark">@Model.TotalPages</strong>
                </span>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const clearSearchBtn = document.getElementById('clearSearchBtn');
            const cards = document.querySelectorAll('.medicine-card-item');
            const noResultsCard = document.getElementById('noResultsCard');
            const paginationContainer = document.getElementById('paginationContainer');

            function filterCards() {
                const term = searchInput.value.toLowerCase().trim();
                let visibleCount = 0;

                cards.forEach(card => {
                    const nameText = card.querySelector('.medicine-name').textContent.toLowerCase();
                    if (nameText.includes(term)) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (noResultsCard) {
                    noResultsCard.style.display = (visibleCount === 0 && cards.length > 0) ? '' : 'none';
                }

                if (paginationContainer) {
                    paginationContainer.style.display = term.length > 0 ? 'none' : 'flex';
                }
            }

            searchInput.addEventListener('input', filterCards);

            clearSearchBtn.addEventListener('click', function() {
                searchInput.value = '';
                filterCards();
                searchInput.focus();
            });
        });
    </script>
}