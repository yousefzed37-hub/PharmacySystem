@model IEnumerable<PharmacyManagement.Web.ViewModels.Medicines.MedicineIndexViewModel>

@{
    ViewData["Title"] = "Medicines List";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2>Medicines List</h2>
        </div>
        <div class="col-md-6 text-end">
           <a asp-controller="Medicine" asp-action="Create" class="btn btn-primary">
            Add New Medicine
        </a>
          
        </div>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Selling Price</th>
                <th>Stock</th>
                <th>Expiry Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var medicine in Model)
            {
                <tr>
                    <td>@medicine.Name</td>
                    <td>@medicine.CategoryName</td>
                    <td>$@medicine.SellingPrice</td>
                    <td>
                        @if (medicine.IsLowStock == true)
                        {
                            <span class="badge bg-danger">@medicine.StockQuantity (Low)</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@medicine.StockQuantity</span>
                        }
                    </td>
                    <td>
                        @if (medicine.IsExpired == true)
                        {
                            <span class="text-danger fw-bold">
                                @(medicine.ExpiryDate.HasValue ? medicine.ExpiryDate.Value.ToString("yyyy-MM-dd") : "No Date") (Expired)
                            </span>
                        }
                        else
                        {
                            <span>
                                @(medicine.ExpiryDate.HasValue ? medicine.ExpiryDate.Value.ToString("yyyy-MM-dd") : "No Date")
                            </span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@medicine.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@medicine.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>