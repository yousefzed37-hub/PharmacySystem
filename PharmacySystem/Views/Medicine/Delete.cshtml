@model PharmacyManagement.Web.ViewModels.Medicines.MedicineIndexViewModel

@{
    ViewData["Title"] = "Delete Medicine";
}

<div class="container-fluid pt-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-danger d-flex align-items-center gap-2 mb-1">
                <i class="bi bi-exclamation-triangle-fill"></i> Delete Confirmation
            </h2>
            <p class="text-muted small mb-0">Please review the medicine details before confirming deletion.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary px-3 d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i> Back to Catalog
        </a>
    </div>

    <!-- Main Card -->
    <div class="row">
        <div class="col-lg-8 col-xl-7">
            
            <!-- Warning Banner -->
            @* <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center gap-3 mb-4 rounded-3 p-3" role="alert">
                <i class="bi bi-exclamation-circle-fill text-warning fs-3"></i>
                <div>
                    <strong class="d-block text-dark">Warning!</strong>
                    <span class="text-secondary small">This action will soft-delete the medicine from the active inventory catalog.</span>
                </div>
            </div> *@

            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <!-- Card Header -->
                <div class="card-header bg-danger text-white py-3 fw-semibold d-flex align-items-center gap-2">
                    <i class="bi bi-trash3-fill"></i> Are you sure you want to delete this medicine?
                </div>

                <!-- Card Body -->
                <div class="card-body p-4">
                    <div class="row g-3">
                        
                        <!-- Medicine Name -->
                        <div class="col-sm-6">
                            <span class="text-muted d-block small mb-1">
                                <i class="bi bi-capsule text-teal me-1" style="color: #0f766e;"></i> Medicine Name
                            </span>
                            <h5 class="fw-bold text-dark mb-0">@Model.Name</h5>
                        </div>

                        <!-- Category -->
                        <div class="col-sm-6">
                            <span class="text-muted d-block small mb-1">
                                <i class="bi bi-tags me-1"></i> Category
                            </span>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2 fw-medium">
                                @Model.CategoryName
                            </span>
                        </div>

                        <hr class="my-2 text-muted opacity-25" />

                        <!-- Selling Price -->
                        <div class="col-sm-6">
                            <span class="text-muted d-block small mb-1">
                                <i class="bi bi-currency-dollar me-1"></i> Selling Price
                            </span>
                            <span class="fs-5 fw-bold text-success">$@Model.SellingPrice</span>
                        </div>

                        <!-- Product ID -->
                        <div class="col-sm-6">
                            <span class="text-muted d-block small mb-1">
                                <i class="bi bi-hash me-1"></i> Product ID
                            </span>
                            <span class="fw-semibold text-secondary">#@Model.Id</span>
                        </div>

                    </div>
                </div>

                <!-- Card Footer / Form -->
                <div class="card-footer bg-light p-3 border-0">
                    <form asp-action="Delete" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger px-4 fw-semibold d-inline-flex align-items-center gap-2">
                                <i class="bi bi-trash-fill"></i> Confirm Delete
                            </button>
                            <a asp-action="Index" class="btn btn-light border px-4 text-secondary">
                                Cancel & Return
                            </a>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>