@model PharmacyManagement.Web.ViewModels.Medicines.MedicineFormViewModel

@{
    ViewData["Title"] = "Create Medicine";
}

<div class="container-fluid pt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold d-flex align-items-center gap-2" style="color: #1e293b;">
            <i class="bi bi-plus-square-fill" style="color: #0f766e;"></i> Create New Medicine
        </h2>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3 p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label text-secondary fw-semibold">
                            <i class="bi bi-capsule me-1"></i> Medicine Name
                        </label>
                        <input asp-for="Name" class="form-control form-control-lg border-light-subtle shadow-sm" placeholder="Enter medicine name..." />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label text-secondary fw-semibold">
                            <i class="bi bi-tag me-1"></i> Category
                        </label>
                        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select form-select-lg border-light-subtle shadow-sm">
                            <option value="">-- Select a Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CostPrice" class="form-label text-secondary fw-semibold">
                                <i class="bi bi-cash-stack me-1"></i> Cost Price ($)
                            </label>
                            <input asp-for="CostPrice" class="form-control form-control-lg border-light-subtle shadow-sm" type="number" step="0.01" />
                            <span asp-validation-for="CostPrice" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SellingPrice" class="form-label text-secondary fw-semibold">
                                <i class="bi bi-receipt me-1"></i> Selling Price ($)
                            </label>
                            <input asp-for="SellingPrice" class="form-control form-control-lg border-light-subtle shadow-sm" type="number" step="0.01" />
                            <span asp-validation-for="SellingPrice" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StockQuantity" class="form-label text-secondary fw-semibold">
                                <i class="bi bi-boxes me-1"></i> Current Stock
                            </label>
                            <input asp-for="StockQuantity" class="form-control form-control-lg border-light-subtle shadow-sm" type="number" />
                            <span asp-validation-for="StockQuantity" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ReorderLevel" class="form-label text-secondary fw-semibold">
                                <i class="bi bi-bell me-1"></i> Reorder Alert Level
                            </label>
                            <input asp-for="ReorderLevel" class="form-control form-control-lg border-light-subtle shadow-sm" type="number" />
                            <span asp-validation-for="ReorderLevel" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ExpiryDate" class="form-label text-secondary fw-semibold">
                            <i class="bi bi-calendar-check me-1"></i> Expiration Date
                        </label>
                        <input asp-for="ExpiryDate" class="form-control form-control-lg border-light-subtle shadow-sm" type="date" />
                        <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-lg px-4 fs-6 d-inline-flex align-items-center gap-2" style="background-color: #0f766e; border-color: #0f766e;">
                            <i class="bi bi-check-lg"></i> Save Medicine
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-lg px-4 fs-6 d-inline-flex align-items-center gap-2">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}