@model PharmacyManagement.Web.ViewModels.Medicines.MedicineIndexViewModel

@{
    ViewData["Title"] = "Medicine Details";
}

<div class="container-fluid p-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-capsule text-teal"></i>
                @Model.Name
            </h2>
            <p class="text-muted mb-0">Detailed inventory and product records.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Catalog
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Product Image Card -->
        <div class="col-md-5 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="fw-bold text-secondary mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-image"></i> Product Image
                    </h6>

                    <div class="d-flex flex-column align-items-center justify-content-center p-4 border border-2 border-dashed rounded-3 bg-light" style="min-height: 280px;">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded" style="max-height: 250px; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="text-center text-muted">
                                <i class="bi bi-capsule text-teal-light mb-2" style="font-size: 4rem;"></i>
                                <p class="mb-0 fw-medium">No Product Image Available</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Stock & Pricing Card -->
        <div class="col-md-7 col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="fw-bold text-secondary mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-box-seam"></i> Stock & Pricing
                    </h6>

                    <!-- Stock Status Alert -->
                    @if (Model.StockQuantity > 0)
                    {
                        <div class="alert alert-success bg-teal text-white border-0 text-center fw-bold py-2 mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> In Stock
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger text-center fw-bold py-2 mb-4" role="alert">
                            <i class="bi bi-x-circle-fill me-2"></i> Out of Stock
                        </div>
                    }

                    <!-- Details Table / List -->
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <span class="text-muted">Category</span>
                        <span class="badge bg-light text-dark border px-3 py-2 fs-6">@Model.CategoryName</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <span class="text-muted">Selling Price</span>
                        <span class="fs-3 fw-bold text-teal">$@Model.SellingPrice.ToString("F2")</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <span class="text-muted">Available Quantity</span>
                        <span class="fs-5 fw-bold text-dark">@Model.StockQuantity units</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom mb-4">
                        <span class="text-muted">Expiration Date</span>
                        <span class="fw-medium text-dark">@Model.ExpiryDate?.ToString("yyyy-MM-dd")</span>
                    </div>

                    <!-- Actions Buttons -->
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white fw-bold py-2">
                            <i class="bi bi-pencil-square me-1"></i> Edit Details
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger fw-bold py-2">
                            <i class="bi bi-trash me-1"></i> Delete Medicine
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>