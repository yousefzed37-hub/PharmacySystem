@model PharmacyManagement.Web.ViewModels.Medicines.MedicineIndexViewModel

@{
    ViewData["Title"] = "Medicine Details";
}

<div class="container-fluid pt-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold d-flex align-items-center gap-2 mb-1" style="color: #1e293b;">
                <i class="bi bi-capsule-pill" style="color: #0f766e;"></i> @Model.Name
            </h2>
            <p class="text-muted small mb-0">Detailed clinical information and inventory records.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary px-3 d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i> Back to Catalog
        </a>
    </div>

    <div class="row g-4">
        <!-- Main Clinical Details Column -->
        <div class="col-lg-8">
            <!-- 1. Basic & Active Ingredient Card -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-light border-0 py-3 fw-bold text-secondary">
                    <i class="bi bi-journal-medical me-1" style="color: #0f766e;"></i> Medical Profile
                </div>
                <div class="card-body p-4">
                    <!-- Active Ingredient -->
                    <div class="mb-4">
                        <span class="text-muted d-block small mb-1 fw-semibold">ACTIVE INGREDIENT(S)</span>
                        <span class="fs-5 fw-bold text-dark bg-light px-3 py-2 rounded-2 d-inline-block border">
                            <i class="bi bi-flask me-2 text-teal" style="color: #0f766e;"></i>
                            @(string.IsNullOrWhiteSpace(Model.ActiveIngredient) ? "Not Specified" : Model.ActiveIngredient)
                        </span>
                    </div>

                    <div class="row g-3">
                        <!-- Indications -->
                        <div class="col-12">
                            <span class="text-muted d-block small mb-1 fw-semibold">INDICATIONS & USES</span>
                            <p class="text-secondary mb-0 bg-light p-3 rounded-2 border">
                                @(string.IsNullOrWhiteSpace(Model.Indications) ? "No specific indications listed." : Model.Indications)
                            </p>
                        </div>

                        <!-- Dosage -->
                        <div class="col-md-6">
                            <span class="text-muted d-block small mb-1 fw-semibold">DOSAGE & ADMINISTRATION</span>
                            <p class="text-secondary mb-0 bg-light p-3 rounded-2 border small">
                                @(string.IsNullOrWhiteSpace(Model.Dosage) ? "Consult pharmacist/physician." : Model.Dosage)
                            </p>
                        </div>

                        <!-- Side Effects -->
                        <div class="col-md-6">
                            <span class="text-muted d-block small mb-1 fw-semibold">POSSIBLE SIDE EFFECTS</span>
                            <p class="text-secondary mb-0 bg-light p-3 rounded-2 border small">
                                @(string.IsNullOrWhiteSpace(Model.SideEffects) ? "None reported." : Model.SideEffects)
                            </p>
                        </div>

                        <!-- Contraindications -->
                        <div class="col-12">
                            <span class="text-muted d-block small mb-1 fw-semibold text-danger">CONTRAINDICATIONS (WARNINGS)</span>
                            <div class="alert alert-danger bg-danger bg-opacity-10 text-danger border-danger border-opacity-25 mb-0 p-3 rounded-2 small">
                                <i class="bi bi-exclamation-octagon-fill me-1"></i>
                                @(string.IsNullOrWhiteSpace(Model.Contraindications) ? "No critical warnings registered." : Model.Contraindications)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar: Inventory & Stock Info Column -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light border-0 py-3 fw-bold text-secondary">
                    <i class="bi bi-box-seam me-1" style="color: #0f766e;"></i> Stock & Pricing
                </div>
                <div class="card-body p-4">

                    <!-- Stock Badge -->
                    <div class="mb-4 text-center">
                        @if (Model.IsOutOfStock)
                        {
                            <span class="badge bg-danger rounded-pill px-3 py-2 fs-6 w-100">
                                <i class="bi bi-x-circle-fill me-1"></i> Out of Stock
                            </span>
                        }
                        else if (Model.IsLowStock)
                        {
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fs-6 w-100">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Low Stock
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success rounded-pill px-3 py-2 fs-6 w-100">
                                <i class="bi bi-check-circle-fill me-1"></i> In Stock
                            </span>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                        <span class="text-muted small">Category</span>
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border">@Model.CategoryName</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                        <span class="text-muted small">Selling Price</span>
                        <span class="fs-4 fw-bold text-success">$@Model.SellingPrice</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                        <span class="text-muted small">Available Quantity</span>
                        <span class="fs-5 fw-bold text-dark">@Model.StockQuantity units</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                        <span class="text-muted small">Shelf Location</span>
                        <span class="fw-semibold text-secondary"><i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrWhiteSpace(Model.ShelfLocation) ? "Unassigned" : Model.ShelfLocation)</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="text-muted small">Expiration Date</span>
                        <span class="fw-medium text-dark">
                            @(Model.ExpiryDate.HasValue ? Model.ExpiryDate.Value.ToString("yyyy-MM-dd") : "No Date")
                        </span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex flex-column gap-2 pt-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning fw-semibold text-white d-inline-flex align-items-center justify-content-center gap-2" style="background-color: #f59e0b; border-color: #f59e0b;">
                            <i class="bi bi-pencil-square"></i> Edit Details
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger fw-semibold d-inline-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-trash"></i> Delete Medicine
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>