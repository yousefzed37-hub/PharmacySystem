@model IEnumerable<PharmacySystem.Models.DBModels.Medicine>

@{
    ViewData["Title"] = "Expiring Medicines";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold m-0 text-danger">
                <i class="bi bi-calendar-x me-2"></i>Expiring Medicines
            </h3>
            <p class="text-muted small m-0">Medicines reaching expiration within the next 30 days.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f8fafc; color: #0f766e;">
                        <tr>
                            <th class="ps-4">Medicine Name</th>
                            <th>Category</th>
                            <th>Stock Quantity</th>
                            <th>Price</th>
                            <th>Expiry Date</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-success fw-semibold">
                                    <i class="bi bi-check-circle fs-3 d-block mb-2"></i>
                                    Great! No medicines are expiring within the next 30 days.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var med in Model)
                            {
                                var daysLeft = (med.ExpiryDate - DateTime.UtcNow).Days;
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@med.Name</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(med.Category?.Name ?? "N/A")
                                        </span>
                                    </td>
                                    <td class="fw-semibold">@med.StockQuantity Units</td>
                                    <td>@med.CostPrice.ToString("C")</td>
                                    <td class="fw-bold">@med.ExpiryDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-1 bg-danger-subtle text-danger border border-danger-subtle">
                                            @daysLeft Days left
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="Medicine" asp-action="Edit" asp-route-id="@med.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>