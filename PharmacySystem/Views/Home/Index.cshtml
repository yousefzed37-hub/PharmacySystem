@model PharmacySystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold m-0" style="color: #0f766e;">
                <i class="bi bi-grid-1x2-fill me-2"></i>Dashboard Overview
            </h3>
            <p class="text-muted small m-0">Welcome back! Here is a summary of your system entities.</p>
        </div>
        <a asp-controller="Sale" asp-action="Create" class="btn text-white rounded-pill px-4 shadow-sm" style="background-color: #0f766e;">
            <i class="bi bi-cart-plus me-1"></i> Quick New Sale
        </a>
    </div>

    <!-- Stats Cards Grid -->
    <div class="row g-3 mb-4">
        <!-- Total Medicines -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4" style="border-color: #0f766e !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Medicines</span>
                        <h2 class="fw-bold mb-0 mt-1" style="color: #0f766e;">@Model.TotalMedicines</h2>
                    </div>
                    <div class="rounded-circle p-3" style="background-color: #e6f4f1; color: #0f766e;">
                        <i class="bi bi-capsule fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Categories -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Categories</span>
                        <h2 class="fw-bold mb-0 mt-1 text-info">@Model.TotalCategories</h2>
                    </div>
                    <div class="rounded-circle p-3 bg-info bg-opacity-10 text-info">
                        <i class="bi bi-tags fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Suppliers -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-secondary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Suppliers</span>
                        <h2 class="fw-bold mb-0 mt-1 text-secondary">@Model.TotalSuppliers</h2>
                    </div>
                    <div class="rounded-circle p-3 bg-secondary bg-opacity-10 text-secondary">
                        <i class="bi bi-truck fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Sales Invoices -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Sales Invoices</span>
                        <h2 class="fw-bold mb-0 mt-1 text-warning">@Model.TotalInvoices</h2>
                    </div>
                    <div class="rounded-circle p-3 bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-receipt fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Links -->
    <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
        <h5 class="fw-bold mb-3" style="color: #0f766e;">
            <i class="bi bi-lightning-charge me-2"></i>Quick Navigation
        </h5>
        <div class="row g-3">
            <div class="col-md-3">
                <a asp-controller="Sale" asp-action="Index" class="btn btn-outline-teal w-100 p-3 text-start rounded-3 border d-flex align-items-center justify-content-between text-decoration-none">
                    <span class="fw-semibold text-dark"><i class="bi bi-receipt me-2" style="color: #0f766e;"></i> Sales Invoices</span>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="Medicine" asp-action="Index" class="btn btn-outline-teal w-100 p-3 text-start rounded-3 border d-flex align-items-center justify-content-between text-decoration-none">
                    <span class="fw-semibold text-dark"><i class="bi bi-capsule me-2" style="color: #0f766e;"></i> Manage Medicines</span>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="Category" asp-action="Index" class="btn btn-outline-teal w-100 p-3 text-start rounded-3 border d-flex align-items-center justify-content-between text-decoration-none">
                    <span class="fw-semibold text-dark"><i class="bi bi-tags me-2" style="color: #0f766e;"></i> Categories</span>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="Supplier" asp-action="Index" class="btn btn-outline-teal w-100 p-3 text-start rounded-3 border d-flex align-items-center justify-content-between text-decoration-none">
                    <span class="fw-semibold text-dark"><i class="bi bi-truck me-2" style="color: #0f766e;"></i> Suppliers</span>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
            </div>
        </div>
    </div>
</div>