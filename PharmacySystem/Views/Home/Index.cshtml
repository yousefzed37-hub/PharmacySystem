@model PharmacySystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold m-0" style="color: #0f766e;">
                <i class="bi bi-grid-1x2-fill me-2"></i>Dashboard Overview
            </h3>
            <p class="text-muted small m-0">Welcome back! Here is a summary of your system entities.</p>
        </div>
        <a asp-controller="Sale" asp-action="Create" class="btn text-white rounded-pill px-4 shadow-sm" style="background-color: #0f766e;">
            <i class="bi bi-cart-plus me-1"></i> Quick New Sale
        </a>
    </div>

    <!-- Stats Cards Grid (3 per row) -->
    <div class="row g-3 mb-4">
        <!-- 1. Medicines -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4" style="border-color: #0f766e !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Medicines</span>
                        <h2 class="fw-bold mb-0 mt-1" style="color: #0f766e;">@Model.TotalMedicines</h2>
                    </div>
                    <div class="rounded-circle p-3" style="background-color: #e6f4f1; color: #0f766e;">
                        <i class="bi bi-capsule fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Categories -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Categories</span>
                        <h2 class="fw-bold mb-0 mt-1 text-info">@Model.TotalCategories</h2>
                    </div>
                    <div class="rounded-circle p-3 bg-info bg-opacity-10 text-info">
                        <i class="bi bi-tags fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Suppliers -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-secondary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Suppliers</span>
                        <h2 class="fw-bold mb-0 mt-1 text-secondary">@Model.TotalSuppliers</h2>
                    </div>
                    <div class="rounded-circle p-3 bg-secondary bg-opacity-10 text-secondary">
                        <i class="bi bi-truck fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Sales Invoices -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Invoices</span>
                        <h2 class="fw-bold mb-0 mt-1 text-warning">@Model.TotalInvoices</h2>
                    </div>
                    <div class="rounded-circle p-3 bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-receipt fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. Expiring Soon -->
        <div class="col-md-4">
            <a asp-controller="Medicine" asp-action="ExpiringSoon" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-danger h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Expiring Soon</span>
                            <h2 class="fw-bold mb-0 mt-1 text-danger">@Model.ExpiringSoonCount</h2>
                        </div>
                        <div class="rounded-circle p-3 bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-exclamation-triangle fs-3"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- 6. Low Stock -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-dark">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Low Stock (&lt;=5)</span>
                        <h2 class="fw-bold mb-0 mt-1 text-dark">@Model.LowStockCount</h2>
                    </div>
                    <div class="rounded-circle p-3 bg-dark bg-opacity-10 text-dark">
                        <i class="bi bi-box-seam fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tables Row (Side by Side) -->
    <div class="row g-3">
        <!-- Expiring Soon Table -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden h-100">
                <!-- Header الخاص بالجدول وبداخله زرار View All -->
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
                    <h6 class="m-0 fw-bold text-danger">
                        <i class="bi bi-calendar-x me-2"></i>Expiring Soon (Within 30 Days)
                    </h6>
                    <a asp-controller="Medicine" asp-action="ExpiringSoon" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                        View All (@Model.ExpiringSoonCount) <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Medicine</th>
                                    <th>Expiry Date</th>
                                    <th>Days Left</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.ExpiringMedicines.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-success fw-semibold">No expiring medicines!</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var med in Model.ExpiringMedicines)
                                    {
                                        var daysLeft = (med.ExpiryDate - DateTime.UtcNow).Days;
                                        <tr>
                                            <td class="ps-3 fw-bold">@med.Name</td>
                                            <td>@med.ExpiryDate.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                <span class="badge bg-danger-subtle text-danger rounded-pill px-2 py-1">
                                                    @daysLeft Days
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Low Stock Table -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden h-100">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h6 class="m-0 fw-bold text-dark">
                        <i class="bi bi-box-seam me-2"></i>Low Stock Warnings (&lt;= 5 Units)
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Medicine</th>
                                    <th>Stock Left</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.LowStockMedicines.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-success fw-semibold">Stock levels are healthy!</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var med in Model.LowStockMedicines)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-bold">@med.Name</td>
                                            <td>
                                                <span class="badge bg-warning-subtle text-dark border border-warning rounded-pill px-2 py-1">
                                                    @med.StockQuantity Units
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <a asp-controller="Medicine" asp-action="Edit" asp-route-id="@med.Id" class="btn btn-sm btn-outline-secondary rounded-pill">
                                                    Restock
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>