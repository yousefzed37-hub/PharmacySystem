@model PharmacyManagement.Web.ViewModels.Categories.CategoryIndexViewModel

@{
    ViewData["Title"] = "Category Details";
}

<div class="container-fluid pt-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold d-flex align-items-center gap-2 mb-1" style="color: #1e293b;">
                <i class="bi bi-folder-fill" style="color: #0f766e;"></i> @Model.Name
            </h2>
            <p class="text-muted small mb-0">Overview of category specifications and registered products count.</p>
        </div>
        @* <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-semibold d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i> Back to Catalog
        </a> *@
    </div>

    <!-- Main Card -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-light border-0 py-3 fw-bold text-secondary">
                    <i class="bi bi-info-circle me-1" style="color: #0f766e;"></i> Category Information
                </div>

                <div class="card-body p-4">
                    <div class="row g-4 mb-3">
                        <div class="col-sm-6">
                            <span class="text-muted d-block small mb-1 fw-semibold">CATEGORY NAME</span>
                            <span class="fs-5 fw-bold text-dark">@Model.Name</span>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-muted d-block small mb-1 fw-semibold">TOTAL MEDICINES</span>
                            <span class="badge rounded-pill px-3 py-2 text-white fs-6" style="background-color: #0f766e;">
                                <i class="bi bi-capsule me-1"></i>@Model.MedicinesCount Products
                            </span>
                        </div>

                        <div class="col-12">
                            <hr class="my-1 text-muted opacity-25" />
                        </div>

                        <div class="col-12">
                            <span class="text-muted d-block small mb-1 fw-semibold">DESCRIPTION</span>
                            <p class="text-secondary bg-light p-3 rounded-2 border mb-0">
                                @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided for this category." : Model.Description)
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Card Footer (Back Only) -->
                <div class="card-footer bg-light border-0 p-3">
                    <a asp-action="Index" class="btn btn-secondary px-4 fw-semibold d-inline-flex align-items-center gap-2">
                        <i class="bi bi-arrow-left"></i> Back to Categories
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>