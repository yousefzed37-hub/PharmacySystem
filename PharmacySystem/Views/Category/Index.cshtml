@model IEnumerable<PharmacyManagement.Web.ViewModels.Categories.CategoryIndexViewModel>

@{
    ViewData["Title"] = "Categories List";
}

<div class="container-fluid pt-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-secondary d-flex align-items-center gap-2">
            <i class="bi bi-tags text-teal" style="color: #0f766e;"></i> Categories Catalog
        </h2>
        <a asp-controller="Category" asp-action="Create" class="btn btn-success px-4 fw-semibold d-inline-flex align-items-center gap-2" style="background-color: #0f766e; border-color: #0f766e;">
            <i class="bi bi-plus-circle-fill"></i> Add New Category
        </a>
    </div>

    <!-- Live Search Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-11">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               id="searchInput"
                               class="form-control border-start-0 ps-0"
                               placeholder="Type to filter categories instantly..."
                               autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-1 text-end">
                    <button type="button" id="clearSearchBtn" class="btn btn-outline-secondary w-100 d-inline-flex align-items-center justify-content-center" title="Clear Search">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Cards Grid Container -->
    <div class="row g-3" id="categoriesGrid">
        @if (Model != null && Model.Any())
        {
            @foreach (var category in Model)
            {
                <div class="col-12 col-md-6 col-lg-4 col-xl-3 category-card-item">
                    <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">

                        <!-- Card Header -->
                        <div class="card-header bg-light border-0 d-flex justify-content-between align-items-center pt-3 px-3">
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border fw-normal px-2 py-1">
                                <i class="bi bi-folder me-1"></i>Category
                            </span>
                            <span class="badge rounded-pill px-2 py-1 text-white" style="background-color: #0f766e;">
                                <i class="bi bi-capsule me-1"></i>@category.MedicinesCount Products
                            </span>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body px-3 py-2">
                            <h5 class="fw-bold text-dark mb-2 category-name">
                                <i class="bi bi-tag-fill me-1" style="color: #0f766e;"></i> @category.Name
                            </h5>

                            <div class="my-3">
                                <small class="text-muted d-block mb-1">Description:</small>
                                <p class="text-secondary small mb-0 text-truncate-2" style="min-height: 38px;">
                                    @(string.IsNullOrWhiteSpace(category.Description) ? "No description provided." : category.Description)
                                </p>
                            </div>
                        </div>

                        <!-- Card Footer / Actions -->
                        <div class="card-footer bg-white border-0 d-flex gap-2 p-3 pt-0">
                            <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-warning w-50 d-inline-flex align-items-center justify-content-center gap-1">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger w-50 d-inline-flex align-items-center justify-content-center gap-1">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>

                    </div>
                </div>
            }

            <!-- No Search Results -->
            <div class="col-12" id="noResultsCard" style="display: none;">
                <div class="card border-0 shadow-sm rounded-3 text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    <h5>No categories found matching your search.</h5>
                </div>
            </div>
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-3 text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    <h5>No categories available.</h5>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const clearSearchBtn = document.getElementById('clearSearchBtn');
            const cards = document.querySelectorAll('.category-card-item');
            const noResultsCard = document.getElementById('noResultsCard');

            function filterCards() {
                const term = searchInput.value.toLowerCase().trim();
                let visibleCount = 0;

                cards.forEach(card => {
                    const nameText = card.querySelector('.category-name').textContent.toLowerCase();
                    if (nameText.includes(term)) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (noResultsCard) {
                    noResultsCard.style.display = (visibleCount === 0 && cards.length > 0) ? '' : 'none';
                }
            }

            searchInput.addEventListener('input', filterCards);

            clearSearchBtn.addEventListener('click', function() {
                searchInput.value = '';
                filterCards();
                searchInput.focus();
            });
        });
    </script>
}