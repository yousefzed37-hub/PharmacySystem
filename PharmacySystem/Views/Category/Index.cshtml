@model IEnumerable<PharmacyManagement.Web.ViewModels.Categories.CategoryIndexViewModel>

@{
    ViewData["Title"] = "Categories List";
}

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(15, 118, 110, 0.04) !important;
    }

    .hover-teal:hover {
        color: #0f766e !important;
    }
</style>

<div class="container-fluid pt-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-secondary d-flex align-items-center gap-2 mb-1">
                <i class="bi bi-tags text-teal" style="color: #0f766e;"></i> Categories List
            </h2>
            <p class="text-muted small mb-0">Manage product categories and catalog structure.</p>
        </div>
        <a asp-controller="Category" asp-action="Create" class="btn btn-success px-4 fw-semibold d-inline-flex align-items-center gap-2" style="background-color: #0f766e; border-color: #0f766e;">
            <i class="bi bi-plus-circle-fill"></i> Add New Category
        </a>
    </div>

    <!-- Live Search Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-11">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               id="searchInput"
                               class="form-control border-start-0 ps-0"
                               placeholder="Type to filter categories instantly..."
                               autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-1 text-end">
                    <button type="button" id="clearSearchBtn" class="btn btn-outline-secondary w-100 d-inline-flex align-items-center justify-content-center" title="Clear Search">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Container -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="categoriesTable">
                <thead class="bg-light border-bottom">
                    <tr>
                        <th class="py-3 ps-4 text-secondary small fw-bold text-uppercase">Category Name</th>
                        <th class="py-3 text-secondary small fw-bold text-uppercase">Description</th>
                        <th class="py-3 text-secondary small fw-bold text-uppercase text-center">Products Count</th>
                        <th class="py-3 pe-4 text-secondary small fw-bold text-uppercase text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var category in Model)
                        {
                            <tr class="category-row-item">
                                <!-- Category Name -->
                                <td class="ps-4">
                                    <h6 class="fw-bold mb-0 category-name">
                                        <a asp-action="Details" asp-route-id="@category.Id" class="text-decoration-none text-dark hover-teal">
                                            <i class="bi bi-tag-fill me-2" style="color: #0f766e;"></i>@category.Name
                                        </a>
                                    </h6>
                                </td>

                                <!-- Description -->
                                <td>
                                    <span class="text-secondary small">
                                        @(string.IsNullOrWhiteSpace(category.Description) ? "No description provided." : category.Description)
                                    </span>
                                </td>

                                <!-- Products Count Badge -->
                                <td class="text-center">
                                    <span class="badge rounded-pill px-3 py-2 text-white" style="background-color: #0f766e;">
                                        <i class="bi bi-capsule me-1"></i>@category.MedicinesCount Products
                                    </span>
                                </td>

                                <!-- Actions Buttons -->
                                <td class="pe-4 text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                <h5>No categories available.</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- No Search Results Container -->
        <div id="noResultsCard" class="text-center py-5 text-muted border-top" style="display: none;">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            <h5>No categories found matching your search.</h5>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const clearSearchBtn = document.getElementById('clearSearchBtn');
            const rows = document.querySelectorAll('.category-row-item');
            const noResultsCard = document.getElementById('noResultsCard');

            function filterRows() {
                const term = searchInput.value.toLowerCase().trim();
                let visibleCount = 0;

                rows.forEach(row => {
                    const nameText = row.querySelector('.category-name').textContent.toLowerCase();
                    if (nameText.includes(term)) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (noResultsCard) {
                    noResultsCard.style.display = (visibleCount === 0 && rows.length > 0) ? '' : 'none';
                }
            }

            searchInput.addEventListener('input', filterRows);

            clearSearchBtn.addEventListener('click', function() {
                searchInput.value = '';
                filterRows();
                searchInput.focus();
            });
        });
    </script>
}