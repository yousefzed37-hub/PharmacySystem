@model IEnumerable<PharmacyManagement.Web.ViewModels.Categories.CategoryIndexViewModel>

@{
    ViewData["Title"] = "Categories List";
}

<div class="container-fluid pt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-secondary d-flex align-items-center gap-2">
            <i class="bi bi-tags-fill" style="color: #0f766e;"></i> Categories List
        </h2>
        <a asp-controller="Category" asp-action="Create" class="btn btn-success px-4 fw-semibold d-inline-flex align-items-center gap-2" style="background-color: #0f766e; border-color: #0f766e;">
            <i class="bi bi-plus-circle-fill"></i> Add New Category
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #0f766e; color: #ffffff;">
                        <tr>
                            <th class="py-3 px-3"><i class="bi bi-tag me-1"></i> Category Name</th>
                            <th class="py-3 text-end px-3" style="width: 220px;"><i class="bi bi-gear me-1"></i> Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td class="fw-semibold px-3">
                                    <i class="bi bi-folder2-open me-2 text-muted"></i> @category.Name
                                </td>
                                <td class="text-end px-3">
                                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-warning me-1 d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>