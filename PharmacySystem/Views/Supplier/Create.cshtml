@model PharmacySystem.ViewModels.SupplierViewModel

@{
    ViewData["Title"] = "Add Supplier";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #0d9488;">
                <i class="bi bi-building-add me-2"></i>Add New Supplier
            </h3>
            <p class="text-muted mb-0">Register a new pharmaceutical vendor or distributor.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 rounded-3">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <!-- Form Card -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 bg-white">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-info-circle me-2" style="color: #0d9488;"></i>Company Information
                    </h5>
                </div>
                <div class="card-body pt-0">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4"></div>

                        <div class="row g-3">
                            <!-- Company Name -->
                            <div class="col-md-12">
                                <label asp-for="Name" class="form-label fw-semibold text-secondary small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-building"></i></span>
                                    <input asp-for="Name" class="form-control bg-light border-start-0" placeholder="e.g., Ibnsina Pharma, United Company" />
                                </div>
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <!-- Phone -->
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold text-secondary small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="Phone" class="form-control bg-light border-start-0" placeholder="e.g., 01012345678" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold text-secondary small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control bg-light border-start-0" placeholder="contact@company.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Address -->
                            <div class="col-md-12">
                                <label asp-for="Address" class="form-label fw-semibold text-secondary small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="Address" class="form-control bg-light border-start-0" placeholder="e.g., Distribution Branch, Industrial Zone" />
                                </div>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light border px-4 py-2 rounded-3">Cancel</a>
                            <button type="submit" class="btn text-white px-4 py-2 rounded-3 shadow-sm" style="background-color: #0d9488;">
                                <i class="bi bi-check-circle me-1"></i> Save Supplier
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}