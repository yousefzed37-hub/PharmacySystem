@model IEnumerable<PharmacySystem.ViewModels.SupplierIndexViewModel>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary"><i class="bi bi-truck"></i> Suppliers</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New Supplier
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Supplier Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th class="text-center">Total Orders</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr id="row-@item.Id">
                                <td class="fw-bold">@item.Name</td>
                                <td>@item.Phone</td>
                                <td>@(string.IsNullOrEmpty(item.Email) ? "—" : item.Email)</td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">@item.TotalPurchaseOrders</span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                        Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteSupplier(@item.Id)">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No suppliers found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        function deleteSupplier(id) {
            if (!confirm('Are you sure you want to delete this supplier?')) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch(`/Suppliers/Delete/${id}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'Content-Type': 'application/json'
                }
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        const row = document.getElementById(`row-${id}`);
                        if (row) row.remove();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(() => alert('An error occurred while deleting the supplier.'));
        }
    </script>
}