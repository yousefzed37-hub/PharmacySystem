@model PharmacySystem.ViewModels.PurchaseOrderItemViewModel

@{
    ViewData["Title"] = "Add Item to Order";
    int orderId = ViewBag.OrderId;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Add Medicine to Order #@orderId</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" asp-route-orderId="@orderId" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="MedicineId" class="form-label fw-bold"></label>
                            <select asp-for="MedicineId" asp-items="ViewBag.MedicinesList" class="form-select">
                                <option value="">-- Select Medicine --</option>
                            </select>
                            <span asp-validation-for="MedicineId" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Quantity" class="form-label fw-bold"></label>
                                <input asp-for="Quantity" class="form-control" type="number" min="1" id="quantityInput" />
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="UnitPrice" class="form-label fw-bold"></label>
                                <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" min="0.01" id="priceInput" />
                                <span asp-validation-for="UnitPrice" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="alert alert-secondary d-flex justify-content-between align-items-center mb-3">
                            <span>Item Subtotal:</span>
                            <strong id="subtotalDisplay" class="fs-5 text-dark">$0.00</strong>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" asp-route-orderId="@orderId" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success">Add Item</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const qty = document.getElementById('quantityInput');
        const price = document.getElementById('priceInput');
        const subtotal = document.getElementById('subtotalDisplay');

        function updateSubtotal() {
            const q = parseFloat(qty.value) || 0;
            const p = parseFloat(price.value) || 0;
            subtotal.textContent = '$' + (q * p).toFixed(2);
        }

        qty.addEventListener('input', updateSubtotal);
        price.addEventListener('input', updateSubtotal);
        updateSubtotal();
    </script>
}