@model PharmacySystem.ViewModels.SaleViewModel

@{
    ViewData["Title"] = "Create New Invoice";
    var medicines = ViewBag.Medicines as SelectList;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header text-white p-3 border-0" style="background-color: #0f766e;">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-cart-plus me-2"></i>New Sales Invoice</h4>
                </div>

                <div class="card-body p-4 bg-white">
                    <form asp-action="Create" method="post" id="saleForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <h5 class="fw-bold mb-3" style="color: #0f766e;">
                            <i class="bi bi-capsule me-2"></i>Medicine Items
                        </h5>
                        <div class="table-responsive mb-3">
                            <table class="table table-hover align-middle border-0" id="itemsTable">
                                <thead style="background-color: #f8fafc; color: #0f766e;">
                                    <tr>
                                        <th style="width: 40%;">Medicine</th>
                                        <th style="width: 15%;">Quantity</th>
                                        <th style="width: 20%;">Unit Price</th>
                                        <th style="width: 20%;">SubTotal</th>
                                        <th style="width: 5%;" class="text-center">Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Items.Count; i++)
                                    {
                                        <tr class="item-row">
                                            <td>
                                                <select name="Items[@i].MedicineId" class="form-select medicine-select rounded-3" asp-items="medicines" required>
                                                    <option value="">-- Select Medicine --</option>
                                                </select>
                                            </td>
                                            <td>
                                                <input name="Items[@i].Quantity" class="form-control quantity-input rounded-3" type="number" min="1" value="1" required />
                                            </td>
                                            <td>
                                                <input name="Items[@i].UnitPrice" class="form-control price-input rounded-3" type="number" step="0.01" value="" placeholder="0.00" required />
                                            </td>
                                            <td>
                                                <input class="form-control row-subtotal rounded-3 bg-light" type="number" step="0.01" value="0.00" readonly />
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-outline-danger btn-sm remove-row rounded-pill"><i class="bi bi-trash"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <button type="button" class="btn btn-sm rounded-pill px-3 mb-4" id="addRow" style="color: #0f766e; border-color: #0f766e; background-color: #e6f4f1;">
                            <i class="bi bi-plus-lg me-1"></i> Add Another Item
                        </button>

                        <hr class="my-4 text-muted opacity-25" />

                        <div class="row justify-content-end">
                            <div class="col-md-5">
                                <div class="p-3 rounded-3 border-0 shadow-sm" style="background-color: #f8fafc;">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted fw-semibold">SubTotal:</span>
                                        <span class="fw-bold text-dark" id="displaySubTotal">$0.00</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label asp-for="Discount" class="form-label mb-0 text-muted fw-semibold">Discount:</label>
                                        <input asp-for="Discount" class="form-control form-control-sm w-50 text-end rounded-3" id="discountInput" value="0" min="0" step="0.01" />
                                    </div>
                                    <hr class="my-2" />
                                    <div class="d-flex justify-content-between fs-5 fw-bold" style="color: #0f766e;">
                                        <span>Grand Total:</span>
                                        <span id="displayTotalAmount">$0.00</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel & Return</a>
                            <button type="submit" class="btn text-white px-5 rounded-pill shadow-sm" style="background-color: #0f766e;">
                                <i class="bi bi-check2-circle me-1"></i> Save & Issue Invoice
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const tableBody = document.querySelector('#itemsTable tbody');
            const addBtn = document.getElementById('addRow');
            const discountInput = document.getElementById('discountInput');

            // 1. حساب الإجمالي الكلي وإجمالي كل صف
            function calculateTotals() {
                let subTotal = 0;
                const rows = tableBody.querySelectorAll('tr.item-row');

                rows.forEach(row => {
                    const qty = parseFloat(row.querySelector('.quantity-input').value) || 0;
                    const price = parseFloat(row.querySelector('.price-input').value) || 0;
                    const rowSubtotal = qty * price;

                    row.querySelector('.row-subtotal').value = rowSubtotal.toFixed(2);
                    subTotal += rowSubtotal;
                });

                const discount = parseFloat(discountInput.value) || 0;
                const finalTotal = subTotal - discount;

                document.getElementById('displaySubTotal').innerText = '$' + subTotal.toFixed(2);
                document.getElementById('displayTotalAmount').innerText = '$' + (finalTotal > 0 ? finalTotal : 0).toFixed(2);
            }

            // 2. إعادة ترتيب الـ Index لتوافق الـ Model Binder في ASP.NET Core
            function reIndexRows() {
                const rows = tableBody.querySelectorAll('tr.item-row');
                rows.forEach((row, i) => {
                    row.querySelector('.medicine-select').setAttribute('name', `Items[${i}].MedicineId`);
                    row.querySelector('.quantity-input').setAttribute('name', `Items[${i}].Quantity`);
                    row.querySelector('.price-input').setAttribute('name', `Items[${i}].UnitPrice`);
                });
            }

            // 3. إضافة صف دواء جديد
            addBtn.addEventListener('click', function() {
                const firstRow = tableBody.querySelector('tr.item-row');
                const newRow = firstRow.cloneNode(true);

                // تصفير القيم في الصف الجديد
                newRow.querySelector('.medicine-select').selectedIndex = 0;
                newRow.querySelector('.quantity-input').value = 1;
                newRow.querySelector('.price-input').value = '0.00';
                newRow.querySelector('.row-subtotal').value = '0.00';

                tableBody.appendChild(newRow);
                reIndexRows();
                calculateTotals();
            });

            // 4. حذف صف
            tableBody.addEventListener('click', function(e) {
                const removeBtn = e.target.closest('.remove-row');
                if (removeBtn) {
                    const rows = tableBody.querySelectorAll('tr.item-row');
                    if (rows.length > 1) {
                        removeBtn.closest('tr').remove();
                        reIndexRows();
                        calculateTotals();
                    }
                }
            });

            // 5. تحديث الأرقام فوراً عند التغيير في الكمية أو السعر
            tableBody.addEventListener('input', function(e) {
                if (e.target.classList.contains('quantity-input') || e.target.classList.contains('price-input')) {
                    calculateTotals();
                }
            });

            discountInput.addEventListener('input', calculateTotals);

            // تشغيل الحسابات أول ما الصفحة تفتح
            calculateTotals();
        });
    </script>
}