@model PharmacySystem.ViewModels.SaleViewModel

@{
    ViewData["Title"] = "Create New Invoice";
    var medicines = ViewBag.Medicines as SelectList;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <!-- Card Header -->
                <div class="card-header text-white p-3 border-0" style="background-color: #0f766e;">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-cart-plus me-2"></i>New Sales Invoice</h4>
                </div>

                <div class="card-body p-4 bg-white">
                    <form asp-action="Create" method="post" id="saleForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <!-- Invoice Items Table -->
                        <h5 class="fw-bold mb-3" style="color: #0f766e;">
                            <i class="bi bi-capsule me-2"></i>Medicine Items
                        </h5>
                        <div class="table-responsive mb-3">
                            <table class="table table-hover align-middle border-0" id="itemsTable">
                                <thead style="background-color: #f8fafc; color: #0f766e;">
                                    <tr>
                                        <th style="width: 40%;">Medicine</th>
                                        <th style="width: 15%;">Quantity</th>
                                        <th style="width: 20%;">Unit Price</th>
                                        <th style="width: 20%;">SubTotal</th>
                                        <th style="width: 5%;" class="text-center">Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Items.Count; i++)
                                    {
                                        <tr class="item-row">
                                            <td>
                                                <select name="Items[@i].MedicineId" class="form-select medicine-select rounded-3" asp-items="medicines" required>
                                                    <option value="">-- Select Medicine --</option>
                                                </select>
                                            </td>
                                            <td>
                                                <input name="Items[@i].Quantity" class="form-control quantity-input rounded-3" type="number" min="1" value="1" required />
                                            </td>
                                            <td>
                                                <input name="Items[@i].UnitPrice" class="form-control price-input rounded-3" type="number" step="0.01" value="0.00" required />
                                            </td>
                                            <td>
                                                <input class="form-control row-subtotal rounded-3 bg-light" type="number" step="0.01" value="0.00" readonly />
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-outline-danger btn-sm remove-row rounded-pill"><i class="bi bi-trash"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <button type="button" class="btn btn-sm rounded-pill px-3 mb-4" id="addRow" style="color: #0f766e; border-color: #0f766e; background-color: #e6f4f1;">
                            <i class="bi bi-plus-lg me-1"></i> Add Another Item
                        </button>

                        <hr class="my-4 text-muted opacity-25" />

                        <!-- Totals Section -->
                        <div class="row justify-content-end">
                            <div class="col-md-5">
                                <div class="p-3 rounded-3 border-0 shadow-sm" style="background-color: #f8fafc;">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted fw-semibold">SubTotal:</span>
                                        <span class="fw-bold text-dark" id="displaySubTotal">$0.00</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label asp-for="Discount" class="form-label mb-0 text-muted fw-semibold">Discount:</label>
                                        <input asp-for="Discount" class="form-control form-control-sm w-50 text-end rounded-3" id="discountInput" value="0" min="0" step="0.01" />
                                    </div>
                                    <hr class="my-2" />
                                    <div class="d-flex justify-content-between fs-5 fw-bold" style="color: #0f766e;">
                                        <span>Grand Total:</span>
                                        <span id="displayTotalAmount">$0.00</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel & Return</a>
                            <button type="submit" class="btn text-white px-5 rounded-pill shadow-sm" style="background-color: #0f766e;">
                                <i class="bi bi-check2-circle me-1"></i> Save & Issue Invoice
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            function calculateTotals() {
                let subTotal = 0;
                $('#itemsTable tbody tr').each(function() {
                    let qty = parseFloat($(this).find('.quantity-input').val()) || 0;
                    let price = parseFloat($(this).find('.price-input').val()) || 0;
                    let rowTotal = qty * price;
                    $(this).find('.row-subtotal').val(rowTotal.toFixed(2));
                    subTotal += rowTotal;
                });

                let discount = parseFloat($('#discountInput').val()) || 0;
                let finalTotal = subTotal - discount;

                $('#displaySubTotal').text('$' + subTotal.toFixed(2));
                $('#displayTotalAmount').text('$' + (finalTotal > 0 ? finalTotal : 0).toFixed(2));
            }

            $(document).on('input change', '.quantity-input, .price-input, #discountInput', function() {
                calculateTotals();
            });

            $('#addRow').click(function() {
                let index = $('#itemsTable tbody tr').length;
                let newRow = `
                            <tr class="item-row">
                                <td>
                                    <select name="Items[${index}].MedicineId" class="form-select medicine-select rounded-3" required>
                                        ${$('#itemsTable tbody tr:first .medicine-select').html()}
                                    </select>
                                </td>
                                <td>
                                    <input name="Items[${index}].Quantity" class="form-control quantity-input rounded-3" type="number" min="1" value="1" required />
                                </td>
                                <td>
                                    <input name="Items[${index}].UnitPrice" class="form-control price-input rounded-3" type="number" step="0.01" value="0.00" required />
                                </td>
                                <td>
                                    <input class="form-control row-subtotal rounded-3 bg-light" type="number" step="0.01" value="0.00" readonly />
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm remove-row rounded-pill"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>`;
                $('#itemsTable tbody').append(newRow);
                calculateTotals();
            });

            $(document).on('click', '.remove-row', function() {
                if ($('#itemsTable tbody tr').length > 1) {
                    $(this).closest('tr').remove();
                    reIndexRows();
                    calculateTotals();
                }
            });

            function reIndexRows() {
                $('#itemsTable tbody tr').each(function(i) {
                    $(this).find('.medicine-select').attr('name', `Items[${i}].MedicineId`);
                    $(this).find('.quantity-input').attr('name', `Items[${i}].Quantity`);
                    $(this).find('.price-input').attr('name', `Items[${i}].UnitPrice`);
                });
            }
        });
    </script>
}