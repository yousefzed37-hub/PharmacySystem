@model IEnumerable<PharmacySystem.ViewModels.SaleDetailsViewModel>

@{
    ViewData["Title"] = "Sales Invoices";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold m-0" style="color: #0f766e;">
                <i class="bi bi-receipt-cutoff me-2"></i>Sales Invoices Management
            </h3>
            <p class="text-muted small m-0">Complete record of all pharmacy sales transactions</p>
        </div>
        <a asp-action="Create" class="btn text-white rounded-pill px-4 shadow-sm" style="background-color: #0f766e;">
            <i class="bi bi-plus-circle me-1"></i> New Invoice
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 text-white" style="background-color: #0f766e;">
                <div class="d-flex align-items-center">
                    <div class="fs-1 me-3 opacity-75"><i class="bi bi-journal-text"></i></div>
                    <div>
                        <span class="text-white-50 small fw-bold">Total Invoices</span>
                        <h3 class="fw-bold mb-0 mt-1">@Model.Count()</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 text-white" style="background-color: #059669;">
                <div class="d-flex align-items-center">
                    <div class="fs-1 me-3 opacity-75"><i class="bi bi-wallet2"></i></div>
                    <div>
                        <span class="text-white-50 small fw-bold">Total Sales</span>
                        <h3 class="fw-bold mb-0 mt-1">@Model.Sum(x => x.TotalAmount).ToString("C2")</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-warning">
                <div class="d-flex align-items-center">
                    <div class="fs-1 me-3 text-warning"><i class="bi bi-percent"></i></div>
                    <div>
                        <span class="text-muted small fw-bold">Total Discounts</span>
                        <h3 class="fw-bold mb-0 mt-1 text-dark">
                            @Model.Sum(x => x.Discount ?? 0).ToString("C2")
                        </h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f8fafc; color: #0f766e;">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Invoice Number</th>
                            <th>Sale Date</th>
                            <th class="text-center">Items Count</th>
                            <th>Total Amount</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                                    No sales invoices recorded yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var invoice in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">@invoice.Id</td>
                                    <td>
                                        <span class="badge rounded-pill fw-normal px-3 py-2" style="background-color: #f1f5f9; color: #334155;">
                                            <i class="bi bi-hash me-1" style="color: #0f766e;"></i>@invoice.InvoiceNumber
                                        </span>
                                    </td>
                                    <td>
                                        <div><i class="bi bi-calendar3 me-1 text-muted"></i>@invoice.SaleDate.ToString("yyyy-MM-dd")</div>
                                        <small class="text-muted"><i class="bi bi-clock me-1"></i>@invoice.SaleDate.ToString("hh:mm tt")</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill fw-normal px-3 py-2" style="background-color: #e6f4f1; color: #0f766e;">
                                            @invoice.Items.Count Items
                                        </span>
                                    </td>
                                    <td class="fw-bold fs-6" style="color: #0f766e;">
                                        @invoice.TotalAmount.ToString("C2")
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@invoice.Id" class="btn btn-sm rounded-pill px-3" style="color: #0f766e; border-color: #0f766e;">
                                            <i class="bi bi-eye me-1"></i> View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>