@model IEnumerable<PharmacySystem.ViewModels.SaleDetailsViewModel>

@{
    ViewData["Title"] = "Sales Invoices";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary m-0"><i class="bi bi-receipt-cutoff me-2"></i>Sales Invoices Management</h2>
            <p class="text-muted small m-0">Complete record of all pharmacy sales transactions</p>
        </div>
        <a asp-action="Create" class="btn btn-success btn-lg shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> New Invoice
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white p-3">
                <div class="d-flex align-items-center">
                    <div class="fs-1 me-3"><i class="bi bi-journal-text"></i></div>
                    <div>
                        <h6 class="mb-0">Total Invoices</h6>
                        <h3 class="fw-bold mb-0">@Model.Count()</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white p-3">
                <div class="d-flex align-items-center">
                    <div class="fs-1 me-3"><i class="bi bi-cash-stack"></i></div>
                    <div>
                        <h6 class="mb-0">Total Sales</h6>
                        <h3 class="fw-bold mb-0">@Model.Sum(x => x.TotalAmount).ToString("C2")</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-warning text-dark p-3">
                <div class="d-flex align-items-center">
                    <div class="fs-1 me-3"><i class="bi bi-percent"></i></div>
                    <div>
                        <h6 class="mb-0">Total Discounts</h6>
                        <h3 class="fw-bold mb-0">@Model.Sum(x => x.Discount)?.ToString("C2")</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Invoice Number</th>
                            <th>Sale Date</th>
                            <th class="text-center">Items Count</th>
                            <th>Total Amount</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No sales invoices recorded yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var invoice in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">@invoice.Id</td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                                            <i class="bi bi-hash me-1 text-primary"></i>@invoice.InvoiceNumber
                                        </span>
                                    </td>
                                    <td>
                                        <div><i class="bi bi-calendar3 me-1 text-muted"></i>@invoice.SaleDate.ToString("yyyy-MM-dd")</div>
                                        <small class="text-muted"><i class="bi bi-clock me-1"></i>@invoice.SaleDate.ToString("hh:mm tt")</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill bg-info text-dark px-3">
                                            @invoice.Items.Count items
                                        </span>
                                    </td>
                                    <td class="fw-bold text-success fs-6">
                                        @invoice.TotalAmount.ToString("C2")
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@invoice.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                            <i class="bi bi-eye me-1"></i> View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>