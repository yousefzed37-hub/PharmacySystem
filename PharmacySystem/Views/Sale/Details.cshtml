@model PharmacySystem.ViewModels.SaleDetailsViewModel

@{
    ViewData["Title"] = $"Invoice Details - {Model.InvoiceNumber}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3 d-print-none">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
        <button onclick="window.print()" class="btn btn-primary">
            <i class="bi bi-printer me-1"></i> Print Invoice
        </button>
    </div>

    <!-- Printable Invoice Card -->
    <div class="card border-0 shadow-lg p-4 bg-white" id="printableArea">
        <!-- Receipt Header -->
        <div class="row border-bottom pb-4 mb-4 align-items-center">
            <div class="col-6">
                <h3 class="fw-bold text-primary mb-1"><i class="bi bi-hospital me-2"></i>Pharmacy System</h3>
                <p class="text-muted small m-0">Sales & Inventory Management</p>
            </div>
            <div class="col-6 text-end">
                <span class="badge bg-primary fs-6 mb-2">Sales Receipt</span>
                <h5 class="fw-bold mb-0"># @Model.InvoiceNumber</h5>
                <small class="text-muted"><i class="bi bi-calendar-event me-1"></i>@Model.SaleDate.ToString("yyyy/MM/dd - hh:mm tt")</small>
            </div>
        </div>

        <!-- Medicine Details Table -->
        <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-list-check me-2"></i>Purchased Items</h5>
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Medicine Name</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">SubTotal</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        var item = Model.Items[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td class="fw-bold text-dark">@item.MedicineName</td>
                            <td class="text-center"><span class="badge bg-light text-dark border">@item.Quantity</span></td>
                            <td class="text-end">@item.UnitPrice.ToString("C2")</td>
                            <td class="text-end fw-bold">@item.SubTotal.ToString("C2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Summary Totals -->
        <div class="row justify-content-end">
            <div class="col-md-5">
                <ul class="list-group list-group-flush border rounded">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        SubTotal:
                        <span class="fw-bold">@Model.SubTotal.ToString("C2")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center text-danger">
                        Discount:
                        <span class="fw-bold">- @Model.Discount?.ToString("C2")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center bg-light fs-5 fw-bold text-success">
                        Total Amount Due:
                        <span>@Model.TotalAmount.ToString("C2")</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center text-muted border-top pt-3 mt-5 small">
            <p class="mb-0">Thank you for visiting! Wish you good health!</p>
        </div>
    </div>
</div>

<style>
    @@media print {
        .d-print-none {
            display: none !important;
        }

        body {
            background-color: #fff !important;
        }

        .card {
            box-shadow: none !important;
            border: none !important;
        }
    }
</style>