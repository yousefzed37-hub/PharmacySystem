<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PharmaCare MS</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ===================== SIDEBAR ===================== -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="sidebar-brand">
                <i class="fa-solid fa-briefcase-medical brand-icon"></i>
                <span class="brand-text">PharmaCare</span>
            </a>
            <button class="btn sidebar-close d-lg-none" id="sidebarClose" aria-label="Close sidebar">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link active" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-gauge-high"></i>
                        <span class="link-text">Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Sale" asp-action="Index">
                        <i class="fa-solid fa-cash-register"></i>
                        <span class="link-text">POS (Sales)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="PurchaseOrder" asp-action="Index">
                        <i class="fa-solid fa-boxes-stacked"></i>
                        <span class="link-text">Purchase Order</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Medicine" asp-action="Index">
                        <i class="fa-solid fa-pills"></i>
                        <span class="link-text">Medicines</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Category" asp-action="Index">
                        <i class="fa-solid fa-tags"></i>
                        <span class="link-text">Categories</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Supplier" asp-action="Index">
                        <i class="fa-solid fa-truck-medical"></i>
                        <span class="link-text">Suppliers</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Reports" asp-action="Index">
                        <i class="fa-solid fa-chart-line"></i>
                        <span class="link-text">Reports</span>
                    </a>
                </li>

                <li class="nav-divider"><span>System</span></li>

                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Settings" asp-action="Index">
                        <i class="fa-solid fa-gear"></i>
                        <span class="link-text">Settings</span>
                    </a>
                </li>
            </ul>
        </nav>
    </aside>

    <!-- Overlay for mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- ===================== MAIN WRAPPER ===================== -->
    <div class="main-wrapper" id="mainWrapper">

        <!-- TOP NAVBAR -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="btn toggle-btn" id="sidebarToggle" aria-label="Toggle sidebar">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <form class="global-search d-none d-md-flex" method="get">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input type="search" class="form-control" placeholder="Search medicines, invoices, suppliers..." aria-label="Search" />
                </form>
            </div>

            <div class="topbar-right">
                <div class="dropdown notification-dropdown">
                    <button class="btn icon-btn position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa-solid fa-bell"></i>
                        <span class="badge-dot">3</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end notification-menu">
                        <li class="dropdown-header">Notifications</li>
                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="fa-solid fa-triangle-exclamation text-warning"></i>
                                <div>
                                    <p class="mb-0">Low stock: Paracetamol 500mg</p>
                                    <small class="text-muted">10 minutes ago</small>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="fa-solid fa-calendar-xmark text-danger"></i>
                                <div>
                                    <p class="mb-0">3 medicines expiring this week</p>
                                    <small class="text-muted">1 hour ago</small>
                                </div>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item text-center small" href="#">View all notifications</a></li>
                    </ul>
                </div>

                <div class="dropdown user-dropdown">
                    <button class="btn user-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="https://ui-avatars.com/api/?name=Admin+User&background=008080&color=fff"
                             alt="User Avatar" class="user-avatar" />
                        <span class="user-name d-none d-md-inline">Admin User</span>
                        <i class="fa-solid fa-chevron-down small-chevron d-none d-md-inline"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end user-menu">
                        <li class="dropdown-header">
                            <strong>Admin User</strong>
                            <div class="text-muted small">admin@pharmacare.com</div>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">
                                <i class="fa-solid fa-user"></i> My Profile
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-area="" asp-controller="Settings" asp-action="Index">
                                <i class="fa-solid fa-gear"></i> Account Settings
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="fa-solid fa-right-from-bracket"></i> Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- PAGE CONTENT -->
        <main class="page-content">
            <div class="container-fluid">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()

            </div>
        </main>

        <!-- FOOTER -->
        <footer class="page-footer">
            <div class="container-fluid d-flex justify-content-between flex-wrap">
                <span>&copy; @DateTime.Now.Year - PharmaCare Management System. All rights reserved.</span>
                <span class="text-muted">v1.0.0</span>
            </div>
        </footer>

    </div>

    <!-- Bootstrap Bundle (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>

    <!-- Site JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>