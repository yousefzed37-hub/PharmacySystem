@model PharmacySystem.ViewModels.PurchaseOrderViewModel

@{
    ViewData["Title"] = "Receive New Stock";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #0d9488;">
                <i class="bi bi-cart-plus-fill me-2"></i>Receive New Stock
            </h3>
            <p class="text-muted mb-0">Record items arriving from suppliers and instantly update pharmacy stock.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 rounded-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Orders
        </a>
    </div>

    <form asp-action="Create" method="post" id="purchaseOrderForm">
        <div asp-validation-summary="All" class="alert alert-danger"></div>
        @Html.AntiForgeryToken()

        
        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4"></div>

        <div class="row g-4">
            <!-- Left Column: Supplier & Invoice Info -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-info-circle me-2" style="color: #0d9488;"></i>Order Details
                        </h5>
                    </div>
                    <div class="card-body pt-0">
                        <!-- Supplier Select -->
                        <div class="mb-3">
                            <label asp-for="SupplierId" class="form-label fw-semibold text-secondary small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-truck"></i></span>
                                <select asp-for="SupplierId" asp-items="Model.SuppliersList" class="form-select bg-light border-start-0" id="supplierSelect">
                                    <option value="">-- Choose Supplier --</option>
                                </select>
                            </div>
                            <span asp-validation-for="SupplierId" class="text-danger small"></span>
                        </div>

                        <!-- Date -->
                        <div class="mb-3">
                            <label asp-for="OrderDate" class="form-label fw-semibold text-secondary small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="OrderDate" class="form-control bg-light border-start-0" type="date" />
                            </div>
                            <span asp-validation-for="OrderDate" class="text-danger small"></span>
                        </div>

                        <!-- Notes -->
                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label fw-semibold text-secondary small"></label>
                            <textarea asp-for="Notes" class="form-control bg-light" rows="4" placeholder="Add supplier invoice number or notes..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <!-- Summary Amount Box -->
                        <div class="p-3 rounded-3 mt-4 text-center" style="background-color: #f0fdfa; border: 1px dashed #0d9488;">
                            <span class="text-muted small text-uppercase fw-bold">Total Invoiced Amount</span>
                            <h2 class="fw-bolder mb-0 mt-1" style="color: #0d9488;" id="grandTotalDisplay">$0.00</h2>
                        </div>

                        <!-- Save Invoice Submit Button -->
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn text-white btn-lg shadow-sm rounded-3 py-2" style="background-color: #0d9488;" id="btnSubmitOrder">
                                <i class="bi bi-check-circle me-1"></i> Confirm & Receive Stock
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Dropdown Bar + Dynamic Table -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-3 bg-white">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-capsule me-2" style="color: #0d9488;"></i>Purchased Items
                        </h5>
                    </div>
                    <div class="card-body pt-0">
                        <!-- Quick Add Bar (Pure Select Dropdown) -->
                        <div class="p-3 rounded-3 mb-4" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                            <div class="row g-2 align-items-end">
                                <!-- Medicine Dropdown -->
                                <div class="col-md-6">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label small fw-bold text-secondary mb-0">Medicine</label>
                                        <button type="button" class="btn btn-link p-0 text-decoration-none small fw-bold" style="color: #0d9488;" data-bs-toggle="modal" data-bs-target="#quickAddMedicineModal">
                                            <i class="bi bi-plus-circle me-1"></i>New Medicine
                                        </button>
                                    </div>
                                    <div class="input-group">
                                        <select id="medicineSelect" asp-items="Model.MedicinesList" class="form-select">
                                            <option value="">-- Choose Medicine --</option>
                                        </select>
                                        <button type="button" class="btn text-white" style="background-color: #0d9488;" data-bs-toggle="modal" data-bs-target="#quickAddMedicineModal" title="Quick Add">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Quantity -->
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold text-secondary">Qty</label>
                                    <input type="number" id="itemQty" class="form-control" min="1" value="1" />
                                </div>

                                <!-- Unit Price -->
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold text-secondary">Unit Price ($)</label>
                                    <input type="number" id="itemPrice" class="form-control" min="0.01" step="0.01" placeholder="0.00" />
                                </div>

                                <!-- Add Button -->
                                <div class="col-md-2 d-grid">
                                    <button type="button" class="btn text-white fw-bold py-2" style="background-color: #0d9488;" id="btnAddItem">
                                        <i class="bi bi-plus-lg me-1"></i> Add
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Table -->
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="itemsTable">
                                <thead class="table-light text-secondary small text-uppercase">
                                    <tr>
                                        <th style="width: 5%;">#</th>
                                        <th style="width: 45%;">Medicine</th>
                                        <th style="width: 15%;" class="text-center">Quantity</th>
                                        <th style="width: 15%;" class="text-end">Unit Price</th>
                                        <th style="width: 15%;" class="text-end">Subtotal</th>
                                        <th style="width: 5%;" class="text-center">Remove</th>
                                    </tr>
                                </thead>
                                <tbody id="orderItemsBody">
                                    <!-- Rows added dynamically via JavaScript -->
                                </tbody>
                            </table>
                        </div>

                        <!-- Empty State Box -->
                        <div id="emptyItemsAlert" class="text-center py-5">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 60px; height: 60px; background-color: #f1f5f9; color: #94a3b8;">
                                <i class="bi bi-inbox fs-2"></i>
                            </div>
                            <p class="text-muted mb-0">No items added to this order yet. Select a medicine and press <strong>Add</strong>.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Quick Add Medicine Modal -->
<div class="modal fade" id="quickAddMedicineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="bi bi-capsule me-2" style="color: #0d9488;"></i>Quick Add Medicine
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <div id="quickModalError" class="alert alert-danger py-2 px-3 small border-0 rounded-2 d-none"></div>

                <form id="quickMedicineForm">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-secondary">Medicine Name *</label>
                            <input type="text" id="modalMedName" class="form-control" placeholder="e.g. Panadol Extra" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-secondary">Category *</label>
                            <select id="modalMedCategory" class="form-select" asp-items="ViewBag.CategoriesList" required>
                                <option value="">-- Choose Category --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Cost Price ($) *</label>
                            <input type="number" id="modalMedCost" class="form-control" min="0.01" step="0.01" placeholder="0.00" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Sale Price ($) *</label>
                            <input type="number" id="modalMedSale" class="form-control" min="0.01" step="0.01" placeholder="0.00" required />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light border px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn text-white px-4" style="background-color: #0d9488;" id="btnSaveQuickMedicine">
                    <i class="bi bi-check-lg me-1"></i> Save & Select
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
    document.addEventListener("DOMContentLoaded", function () {
        let itemIndex = 0;

        // ===============================================
        // 1. زرار الـ Add Item
        // ===============================================
        const btnAdd = document.getElementById('btnAddItem');
        if (btnAdd) {
            btnAdd.addEventListener('click', function () {
                const medSelect = document.getElementById('medicineSelect');
                const medId = medSelect.value;
                const medName = medSelect.options[medSelect.selectedIndex] ? medSelect.options[medSelect.selectedIndex].text : '';
                const qtyInput = document.getElementById('itemQty');
                const priceInput = document.getElementById('itemPrice');
                
                const quantity = parseInt(qtyInput.value);
                const unitPrice = parseFloat(priceInput.value);

                if (!medId || medId === "") {
                    alert("Please select a medicine first!");
                    medSelect.focus();
                    return;
                }

                if (isNaN(quantity) || quantity <= 0) {
                    alert("Quantity must be at least 1");
                    qtyInput.focus();
                    return;
                }

                if (isNaN(unitPrice) || unitPrice <= 0) {
                    alert("Unit Price must be greater than 0");
                    priceInput.focus();
                    return;
                }

                // فحص التكرار
                const existingInputs = document.querySelectorAll('input[name$=".MedicineId"]');
                for (let input of existingInputs) {
                    if (input.value === medId) {
                        alert("This medicine is already added in the table!");
                        return;
                    }
                }

                const subTotal = (quantity * unitPrice).toFixed(2);
                const tbody = document.getElementById('orderItemsBody');

                const tr = document.createElement('tr');
                tr.className = 'item-row';
                tr.innerHTML = `
                    <td class="row-number fw-bold text-muted"></td>
                    <td>
                        <span class="fw-semibold text-dark">${medName}</span>
                        <input type="hidden" name="Items[${itemIndex}].MedicineId" value="${medId}" />
                        <input type="hidden" name="Items[${itemIndex}].MedicineName" value="${medName}" />
                    </td>
                    <td class="text-center">
                        <span class="badge bg-light text-dark border px-3 py-2 fs-6">${quantity}</span>
                        <input type="hidden" name="Items[${itemIndex}].Quantity" class="item-qty" value="${quantity}" />
                    </td>
                    <td class="text-end text-muted">
                        $${unitPrice.toFixed(2)}
                        <input type="hidden" name="Items[${itemIndex}].UnitPrice" class="item-price" value="${unitPrice}" />
                    </td>
                    <td class="text-end fw-bold text-success">
                        $${subTotal}
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger btn-remove-row rounded-circle" title="Remove">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </td>
                `;

                tbody.appendChild(tr);
                itemIndex++;

                // تفريغ الحقول
                medSelect.value = '';
                qtyInput.value = 1;
                priceInput.value = '';

                updateState();
            });
        }

        // ===============================================
        // 2. زرار Remove Row
        // ===============================================
        document.addEventListener('click', function (e) {
            if (e.target.closest('.btn-remove-row')) {
                const row = e.target.closest('tr');
                row.remove();
                reindex();
                updateState();
            }
        });

        function reindex() {
            itemIndex = 0;
            const rows = document.querySelectorAll('#orderItemsBody tr');
            rows.forEach((row, idx) => {
                row.querySelector('.row-number').textContent = idx + 1;
                row.querySelector('input[name*="MedicineId"]').setAttribute('name', `Items[${idx}].MedicineId`);
                row.querySelector('input[name*="MedicineName"]').setAttribute('name', `Items[${idx}].MedicineName`);
                row.querySelector('input[name*="Quantity"]').setAttribute('name', `Items[${idx}].Quantity`);
                row.querySelector('input[name*="UnitPrice"]').setAttribute('name', `Items[${idx}].UnitPrice`);
                itemIndex++;
            });
        }

        function updateState() {
            const rows = document.querySelectorAll('#orderItemsBody tr');
            const alertBox = document.getElementById('emptyItemsAlert');
            const table = document.getElementById('itemsTable');
            const totalDisplay = document.getElementById('grandTotalDisplay');

            if (rows.length === 0) {
                if (alertBox) alertBox.style.display = 'block';
                if (table) table.style.display = 'none';
            } else {
                if (alertBox) alertBox.style.display = 'none';
                if (table) table.style.display = 'table';
            }

            let grandTotal = 0;
            rows.forEach(r => {
                const q = parseFloat(r.querySelector('.item-qty').value) || 0;
                const p = parseFloat(r.querySelector('.item-price').value) || 0;
                grandTotal += (q * p);
            });

            if (totalDisplay) {
                totalDisplay.textContent = '$' + grandTotal.toFixed(2);
            }
            reindex();
        }

        // ===============================================
        // 3. زرار Save & Select في الـ Modal (Fetch API Native)
        // ===============================================
const btnSaveModal = document.getElementById('btnSaveQuickMedicine');
if (btnSaveModal) {
    btnSaveModal.addEventListener('click', function () {
        const name = document.getElementById('modalMedName').value.trim();
        const categoryId = parseInt(document.getElementById('modalMedCategory').value);
        const costPrice = parseFloat(document.getElementById('modalMedCost').value);
        const salePrice = parseFloat(document.getElementById('modalMedSale').value);
        const errorBox = document.getElementById('quickModalError');

        if (!name || isNaN(categoryId) || isNaN(costPrice) || isNaN(salePrice)) {
            errorBox.classList.remove('d-none');
            errorBox.textContent = "Please fill all required fields.";
            return;
        }

        fetch('/Medicine/QuickCreate', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                Name: name,
                CategoryId: categoryId,
                CostPrice: costPrice,
                SalePrice: salePrice,
                ReorderLevel: 5
            })
        })
        .then(res => res.json())
        .then(res => {
            if (res.success) {
                // ضيف الدواء للـ select واختاره
                const select = document.getElementById('medicineSelect');
                const opt = document.createElement('option');
                opt.value = res.id;
                opt.textContent = res.name;
                opt.selected = true;
                select.appendChild(opt);

                // اكتب سعره في خانة التكلفة
                document.getElementById('itemPrice').value = res.costPrice.toFixed(2);

                // اقفل المودال
                document.getElementById('quickMedicineForm').reset();
                errorBox.classList.add('d-none');

                const modalEl = document.getElementById('quickAddMedicineModal');
                const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modal.hide();
            } else {
                errorBox.classList.remove('d-none');
                errorBox.textContent = res.message;
            }
        })
        .catch(err => {
            errorBox.classList.remove('d-none');
            errorBox.textContent = "Request failed: " + err.message;
        });
    });
}

        updateState();
    });
</script>

    <script>
        $(document).ready(function () {
            let itemIndex = 0;

            // ==========================================
            // 1. زرار Add Item للجدول
            // ==========================================
            $('#btnAddItem').on('click', function () {
                const medSelect = $('#medicineSelect');
                const medicineId = medSelect.val();
                const medicineName = medSelect.find('option:selected').text();
                const quantity = parseInt($('#itemQty').val());
                const unitPrice = parseFloat($('#itemPrice').val());

                if (!medicineId || medicineId === "") {
                    alert('Please select a medicine from the dropdown.');
                    medSelect.focus();
                    return;
                }

                if (isNaN(quantity) || quantity <= 0) {
                    alert('Quantity must be at least 1.');
                    $('#itemQty').focus();
                    return;
                }

                if (isNaN(unitPrice) || unitPrice <= 0) {
                    alert('Unit price must be greater than 0.');
                    $('#itemPrice').focus();
                    return;
                }

                // منع تكرار نفس الدواء
                let alreadyExists = false;
                $('input[name$=".MedicineId"]').each(function () {
                    if ($(this).val() === medicineId) {
                        alreadyExists = true;
                    }
                });

                if (alreadyExists) {
                    alert('This medicine is already in the order table.');
                    return;
                }

                const lineTotal = (quantity * unitPrice).toFixed(2);

                // بناء صف الجدول بأسماء PurchaseOrderItemViewModel المطابقة لكودك:
                // Items[i].MedicineId, Items[i].MedicineName, Items[i].Quantity, Items[i].UnitPrice
                const rowHtml = `
                    <tr class="item-row">
                        <td class="row-number fw-bold text-muted"></td>
                        <td>
                            <span class="fw-semibold text-dark">${medicineName}</span>
                            <input type="hidden" name="Items[${itemIndex}].MedicineId" value="${medicineId}" />
                            <input type="hidden" name="Items[${itemIndex}].MedicineName" value="${medicineName}" />
                        </td>
                        <td class="text-center">
                            <span class="badge bg-light text-dark border px-3 py-2 fs-6">${quantity}</span>
                            <input type="hidden" name="Items[${itemIndex}].Quantity" class="item-qty" value="${quantity}" />
                        </td>
                        <td class="text-end text-muted">
                            $${unitPrice.toFixed(2)}
                            <input type="hidden" name="Items[${itemIndex}].UnitPrice" class="item-price" value="${unitPrice}" />
                        </td>
                        <td class="text-end fw-bold text-success">
                            $${lineTotal}
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-row rounded-circle" title="Remove">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </td>
                    </tr>
                `;

                $('#orderItemsBody').append(rowHtml);
                itemIndex++;

                // تصفير المدخلات
                medSelect.val('');
                $('#itemQty').val(1);
                $('#itemPrice').val('');

                updateUiState();
            });

            // ==========================================
            // 2. زرار حذف سطر من الجدول
            // ==========================================
            $('#orderItemsBody').on('click', '.btn-remove-row', function () {
                $(this).closest('tr').remove();
                reindexRows();
                updateUiState();
            });

            function reindexRows() {
                itemIndex = 0;
                $('#orderItemsBody tr').each(function () {
                    $(this).find('.row-number').text(itemIndex + 1);
                    $(this).find('input[name*="MedicineId"]').attr('name', `Items[${itemIndex}].MedicineId`);
                    $(this).find('input[name*="MedicineName"]').attr('name', `Items[${itemIndex}].MedicineName`);
                    $(this).find('input[name*="Quantity"]').attr('name', `Items[${itemIndex}].Quantity`);
                    $(this).find('input[name*="UnitPrice"]').attr('name', `Items[${itemIndex}].UnitPrice`);
                    itemIndex++;
                });
            }

            function updateUiState() {
                const count = $('#orderItemsBody tr').length;
                if (count === 0) {
                    $('#emptyItemsAlert').show();
                    $('#itemsTable').hide();
                } else {
                    $('#emptyItemsAlert').hide();
                    $('#itemsTable').show();
                }

                let grandTotal = 0;
                $('#orderItemsBody tr').each(function () {
                    const q = parseFloat($(this).find('.item-qty').val()) || 0;
                    const p = parseFloat($(this).find('.item-price').val()) || 0;
                    grandTotal += (q * p);
                });

                $('#grandTotalDisplay').text('$' + grandTotal.toFixed(2));
                reindexRows();
            }

            // ==========================================
            // 3. زرار Save & Select في المودال (QuickCreate)
            // ==========================================
            $('#btnSaveQuickMedicine').on('click', function () {
                const name = $('#modalMedName').val().trim();
                const categoryId = parseInt($('#modalMedCategory').val());
                const costPrice = parseFloat($('#modalMedCost').val());
                const salePrice = parseFloat($('#modalMedSale').val());

                if (!name || isNaN(categoryId) || isNaN(costPrice) || isNaN(salePrice)) {
                    $('#quickModalError').removeClass('d-none').text('Please fill all required fields correctly.');
                    return;
                }

                const token = $('input[name="__RequestVerificationToken"]').val();

                // بيبعت للـ QuickCreate في MedicinesController
                // كائن مطابق لـ MedicineQuickCreateDto بالمللي
                $.ajax({
                    url: '/Medicines/QuickCreate',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': token },
                    data: JSON.stringify({
                        Name: name,
                        CategoryId: categoryId,
                        CostPrice: costPrice,
                        SalePrice: salePrice,
                        ReorderLevel: 5
                    }),
                    success: function (res) {
                        if (res.success) {
                            // 1. إضافة الدواء الجديد للـ Dropdown واختياره
                            const newOption = new Option(res.name, res.id, true, true);
                            $('#medicineSelect').append(newOption);
                            $('#medicineSelect').val(res.id);

                            // 2. تعبئة السعر في خانة الـ Unit Price
                            $('#itemPrice').val(res.costPrice.toFixed(2));

                            // 3. إغلاق وتفريغ المودال
                            $('#quickMedicineForm')[0].reset();
                            $('#quickModalError').addClass('d-none');
                            
                            const modalElement = document.getElementById('quickAddMedicineModal');
                            const modalInstance = bootstrap.Modal.getInstance(modalElement) || new bootstrap.Modal(modalElement);
                            modalInstance.hide();
                        } else {
                            $('#quickModalError').removeClass('d-none').text(res.message);
                        }
                    },
                    error: function (xhr) {
                        console.error(xhr);
                        $('#quickModalError').removeClass('d-none').text('Server error occurred while adding medicine.');
                    }
                });
            });

            // ==========================================
            // 4. زرار حفظ الفاتورة (Guard against empty table)
            // ==========================================
            $('#purchaseOrderForm').on('submit', function (e) {
                if ($('#orderItemsBody tr').length === 0) {
                    e.preventDefault();
                    alert('Please add at least one medicine item to the purchase order before saving.');
                    return false;
                }
            });

            updateUiState();
        });
    </script>
}