@model IEnumerable<PharmacySystem.ViewModels.PurchaseOrderViewModel>

@{
    ViewData["Title"] = "Purchase Orders";
}

<div class="container-fluid py-4">
    <!-- Header Title & Action -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color: #0d9488;">
                <i class="bi bi-receipt-cutoff me-2"></i>Purchase Orders
            </h3>
            <p class="text-muted mb-0">Manage incoming medicine shipments, supplier invoices, and receiving logs.</p>
        </div>
        <a asp-action="Create" class="btn text-white px-4 py-2 shadow-sm rounded-3" style="background-color: #0d9488;">
            <i class="bi bi-plus-lg me-1"></i> New Purchase Order
        </a>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" id="orderSearchInput" class="form-control bg-light border-start-0" placeholder="Search by Order # or Supplier..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-calendar-event"></i></span>
                        <input type="date" id="dateFilterInput" class="form-control bg-light" />
                    </div>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="button" id="btnResetFilter" class="btn btn-light w-100 border text-muted">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Orders Table Card -->
    <div class="card border-0 shadow-sm rounded-3 bg-white">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="ordersTable">
                        <thead class="table-light text-secondary small text-uppercase">
                            <tr>
                                <th class="ps-4 py-3">Order No.</th>
                                <th class="py-3">Supplier Name</th>
                                <th class="py-3">Order Date</th>
                                <th class="py-3 text-end">Total Amount</th>
                                <th class="py-3 text-center pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr class="order-row">
                                    <td class="ps-4 fw-bold">
                                        <span class="badge bg-light text-dark border px-3 py-2">
                                            #PO-@order.Id.ToString("D5")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 38px; height: 38px; background-color: #f0fdfa; color: #0d9488;">
                                                <i class="bi bi-truck"></i>
                                            </div>
                                            <span class="fw-semibold text-dark supplier-name">@order.SupplierName</span>
                                        </div>
                                    </td>
                                    <td class="text-muted order-date">
                                        <i class="bi bi-clock me-1 small"></i>@order.OrderDate.ToString("yyyy-MM-dd")
                                    </td>
                                    <td class="text-end fw-bold fs-6" style="color: #0d9488;">
                                        $@order.TotalCost.ToString("N2")
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group shadow-0">
                                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary" title="View Details">
                                                <i class="bi bi-eye text-primary"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-delete-order"
                                                    data-id="@order.Id"
                                                    data-no="#PO-@order.Id.ToString("D5")"
                                                    data-supplier="@order.SupplierName"
                                                    title="Cancel / Delete Order">
                                                <i class="bi bi-trash text-danger"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background-color: #f0fdfa; color: #0d9488;">
                        <i class="bi bi-cart-x fs-1"></i>
                    </div>
                    <h5 class="fw-bold text-dark">No Purchase Orders Recorded</h5>
                    <p class="text-muted">Start stocking your pharmacy shelves by receiving new items from suppliers.</p>
                    <a asp-action="Create" class="btn text-white px-4 mt-2 rounded-3" style="background-color: #0d9488;">
                        <i class="bi bi-plus-lg me-1"></i> Create First Order
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-3">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Cancel Purchase Order
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p class="text-muted mb-2">Are you sure you want to delete purchase order <strong id="modalOrderNo" class="text-dark"></strong> from <strong id="modalSupplier" class="text-dark"></strong>?</p>
                <div class="alert alert-warning py-2 px-3 small border-0 rounded-2 mb-0">
                    <i class="bi bi-info-circle me-1"></i> Note: This action will permanently reverse inventory adjustments made by this invoice.
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light border px-4" data-bs-dismiss="modal">Close</button>
                <form id="deleteOrderForm" action="/PurchaseOrder/Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="modalOrderId" />
                    <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Live Search Filter
            $('#orderSearchInput, #dateFilterInput').on('keyup change', function () {
                const searchVal = $('#orderSearchInput').val().toLowerCase();
                const dateVal = $('#dateFilterInput').val();

                $('.order-row').each(function () {
                    const orderNo = $(this).find('td:first').text().toLowerCase();
                    const supplier = $(this).find('.supplier-name').text().toLowerCase();
                    const date = $(this).find('.order-date').text().trim();

                    const matchesSearch = orderNo.includes(searchVal) || supplier.includes(searchVal);
                    const matchesDate = !dateVal || date.includes(dateVal);

                    if (matchesSearch && matchesDate) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            });

            // Reset Filter
            $('#btnResetFilter').on('click', function () {
                $('#orderSearchInput').val('');
                $('#dateFilterInput').val('');
                $('.order-row').show();
            });

            // Delete Modal Trigger
            $('.btn-delete-order').on('click', function () {
                const id = $(this).data('id');
                const orderNo = $(this).data('no');
                const supplier = $(this).data('supplier');

                $('#modalOrderId').val(id);
                $('#modalOrderNo').text(orderNo);
                $('#modalSupplier').text(supplier);

                const deleteModal = new bootstrap.Modal(document.getElementById('deleteOrderModal'));
                deleteModal.show();
            });
        });
    </script>
}