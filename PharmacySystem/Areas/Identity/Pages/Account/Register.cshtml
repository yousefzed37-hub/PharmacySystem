@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PharmaCare</title>
    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: #f8fafc;">

    <div class="container py-5">
        <div class="row justify-content-center min-vh-100 align-items-center">
            <div class="col-md-6 col-lg-5">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden my-4">
                    <!-- Header Classy Teal -->
                    <div class="card-header text-white text-center py-4" style="background-color: #0f766e;">
                        <div class="mb-2">
                            <i class="bi bi-person-plus-fill display-5"></i>
                        </div>
                        <h4 class="fw-bold m-0">Create an Account</h4>
                        <small class="text-white-50">Join PharmaCare team today</small>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small border-0 mb-3" role="alert"></div>

                            <!-- Email Field -->
                            <div class="form-floating mb-3">
                                <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                <label asp-for="Input.Email" class="text-muted"><i class="bi bi-envelope me-1"></i> Email address</label>
                                <span asp-validation-for="Input.Email" class="text-danger small ms-1"></span>
                            </div>

                            <!-- Password Field -->
                            <div class="form-floating mb-3">
                                <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="new-password" aria-required="true" placeholder="password" />
                                <label asp-for="Input.Password" class="text-muted"><i class="bi bi-key me-1"></i> Password</label>
                                <span asp-validation-for="Input.Password" class="text-danger small ms-1"></span>
                            </div>

                            <!-- Confirm Password Field -->
                            <div class="form-floating mb-4">
                                <input asp-for="Input.ConfirmPassword" class="form-control rounded-3" autocomplete="new-password" aria-required="true" placeholder="password" />
                                <label asp-for="Input.ConfirmPassword" class="text-muted"><i class="bi bi-key-fill me-1"></i> Confirm Password</label>
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small ms-1"></span>
                            </div>

                            <!-- Submit Button -->
                            <button id="registerSubmit" type="submit" class="btn text-white w-100 py-3 rounded-3 fw-bold shadow-sm" style="background-color: #0f766e;">
                                <i class="bi bi-person-check-fill me-1"></i> Register
                            </button>

                            <hr class="my-4 text-muted opacity-25">

                            <!-- Back to Login -->
                            <div class="text-center">
                                <p class="text-muted small mb-2">Already have an account?</p>
                                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-outline-secondary btn-sm rounded-pill px-4 fw-semibold">
                                    Sign In Here
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>