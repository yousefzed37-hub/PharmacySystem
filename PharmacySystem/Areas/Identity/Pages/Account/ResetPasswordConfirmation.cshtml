@page
@{
    ViewData["Title"] = "Password Reset Confirmed";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset Successful - PharmaCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: #f1f5f9;">
    <div class="container py-5">
        <div class="row justify-content-center min-vh-100 align-items-center">
            <div class="col-11 col-sm-9 col-md-7 col-lg-5 col-xl-4">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-center">
                    <!-- Header -->
                    <div class="card-header text-white py-4 border-0" style="background-color: #0f766e;">
                        <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle mb-3 shadow-sm" style="width: 56px; height: 56px; color: #0f766e;">
                            <i class="bi bi-shield-check fs-3"></i>
                        </div>
                        <h4 class="fw-bold mb-1">Password Changed</h4>
                        <p class="text-white-50 small mb-0">Your account security has been updated</p>
                    </div>

                    <!-- Body -->
                    <div class="card-body p-4 p-md-5 bg-white">
                        <p class="text-muted small mb-4">
                            Your password has been successfully reset. You can now use your new credentials to log into your account.
                        </p>

                        <a asp-page="./Login" class="btn text-white w-100 py-2 rounded-3 fw-bold shadow-sm" style="background-color: #0f766e;">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Proceed to Sign In
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>