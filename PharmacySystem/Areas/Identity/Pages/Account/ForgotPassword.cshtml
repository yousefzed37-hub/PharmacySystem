@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - PharmaCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: #f1f5f9;">
    <div class="container py-5">
        <div class="row justify-content-center min-vh-100 align-items-center">
            <div class="col-11 col-sm-9 col-md-7 col-lg-5 col-xl-4">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <!-- Header -->
                    <div class="card-header text-white text-center py-4 border-0" style="background-color: #0f766e;">
                        <div class="d-inline-flex align-items-center justify-content-center bg-white text-teal rounded-circle mb-3 shadow-sm" style="width: 56px; height: 56px; color: #0f766e;">
                            <i class="bi bi-key-fill fs-3"></i>
                        </div>
                        <h4 class="fw-bold mb-1">Reset Password</h4>
                        <p class="text-white-50 small mb-0">Enter your email to receive recovery instructions</p>
                    </div>

                    <!-- Body -->
                    <div class="card-body p-4 p-md-5 bg-white">
                        <form method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small border-0 mb-3" role="alert"></div>

                            <div class="mb-4">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted ps-3"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Input.Email" class="form-control border-start-0 py-2 ps-2" placeholder="Email address" autocomplete="username" aria-required="true" />
                                </div>
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn text-white w-100 py-2 mb-4 rounded-3 fw-bold shadow-sm" style="background-color: #0f766e;">
                                <i class="bi bi-send me-1"></i> Send Reset Link
                            </button>

                            <hr class="text-muted opacity-25 mb-4" />

                            <div class="text-center">
                                <p class="text-muted small mb-2">Remember your password?</p>
                                <a asp-page="./Login" class="btn btn-outline-secondary btn-sm rounded-pill px-4 fw-semibold text-decoration-none">
                                    Back to Sign In
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>